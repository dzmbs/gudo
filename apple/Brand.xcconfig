// Every product-name-bearing string of the Apple apps is defined here (and in crates/brand for
// Rust). Renaming the product means editing these two files; nothing else hard-codes the name.
// Swift code reads the name back from the bundle (CFBundleName).

BRAND_NAME = Gudo
BRAND_BUNDLE_ID_PREFIX = dev.gudo
// Deep links (`<scheme>://pair/<ticket>`); must match crates/brand URL_SCHEME.
BRAND_URL_SCHEME = gudo
// Universal links (`https://<domain>/pair#…`, `/join#…`); must match crates/brand WEB_DOMAIN.
BRAND_WEB_DOMAIN = gudo.dev
// The bundled helper (`Contents/MacOS/<this>`); must match crates/brand DAEMON_BIN.
BRAND_DAEMON_BIN = gudo-hostd
// The short command for the helper (a link to it); must match crates/brand CLI_BIN.
BRAND_CLI_BIN = gudo

// The Apple developer team. Release builds sign with it; Debug builds keep signing to run
// locally (ad-hoc), so they build and run without the team's certificates.
BRAND_TEAM_ID = 8SP2H5J666
DEVELOPMENT_TEAM[config=Release] = $(BRAND_TEAM_ID)

// Push notifications (docs/PUSH.md §8) and universal links. They need the paid team: the APNs
// and Associated Domains entitlements, a Keychain access group and an App Group shared with the
// Notification Service Extension. PUSH_ENTITLEMENT = NO builds without them: the app and the
// extensions build and run, local notifications work, nothing registers with APNs, and links
// to the web domain open in the browser. PUSH_ENTITLEMENT = YES (with provisioning profiles for
// the team) turns on everything below.
PUSH_ENTITLEMENT = NO
PUSH_ENTITLEMENTS_FILE_YES = App/Push.entitlements
APP_ENTITLEMENTS_FILE_YES = App/App.entitlements
PUSH_KEYCHAIN_GROUP_YES = $(BRAND_TEAM_ID).$(BRAND_BUNDLE_ID_PREFIX).shared
PUSH_APP_GROUP_YES = group.$(BRAND_BUNDLE_ID_PREFIX).app
PUSH_ENTITLEMENTS_FILE = $(PUSH_ENTITLEMENTS_FILE_$(PUSH_ENTITLEMENT))
APP_ENTITLEMENTS_FILE = $(APP_ENTITLEMENTS_FILE_$(PUSH_ENTITLEMENT))
PUSH_KEYCHAIN_GROUP = $(PUSH_KEYCHAIN_GROUP_$(PUSH_ENTITLEMENT))
PUSH_APP_GROUP = $(PUSH_APP_GROUP_$(PUSH_ENTITLEMENT))

// Paired hosts in the Files app (the FilesProvider extension, docs/APP-ARCHITECTURE.md §22).
// The extension runs without the app, so it reads the hosts, tickets and this device's key
// from an App Group and a Keychain group shared with the app: the paid team again (the same
// groups as push). FILES_PROVIDER = NO keeps it out: the extension builds by its own scheme and
// is not embedded. For YES, also add `- target: FilesProvider` to App's dependencies in
// project.yml; the app gets the same groups from App/App.entitlements.
FILES_PROVIDER = NO
FILES_PROVIDER_ENTITLEMENTS_FILE_YES = FilesProvider/FilesProvider.entitlements
FILES_KEYCHAIN_GROUP_YES = $(PUSH_KEYCHAIN_GROUP_YES)
FILES_APP_GROUP_YES = $(PUSH_APP_GROUP_YES)
FILES_PROVIDER_ENTITLEMENTS_FILE = $(FILES_PROVIDER_ENTITLEMENTS_FILE_$(FILES_PROVIDER))
FILES_KEYCHAIN_GROUP = $(FILES_KEYCHAIN_GROUP_$(FILES_PROVIDER))
FILES_APP_GROUP = $(FILES_APP_GROUP_$(FILES_PROVIDER))
