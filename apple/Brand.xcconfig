// Every product-name-bearing string of the Apple apps is defined here (and in crates/brand for
// Rust). Renaming the product means editing these two files; nothing else hard-codes the name.
// Swift code reads the name back from the bundle (CFBundleName).

BRAND_NAME = unnamed
BRAND_BUNDLE_ID_PREFIX = dev.unnamed
// Deep links (`<scheme>://pair/<ticket>`); must match crates/brand URL_SCHEME.
BRAND_URL_SCHEME = unnamed

// Push notifications (docs/PUSH.md §8). They need a paid team: the APNs entitlement, a Keychain
// access group and an App Group shared with the Notification Service Extension. With a free
// account keep PUSH_ENTITLEMENT = NO: the app and the extensions build and run, local
// notifications work, and nothing registers with APNs. With a team:
//   PUSH_ENTITLEMENT = YES
//   PUSH_ENTITLEMENTS_FILE = App/Push.entitlements
//   PUSH_KEYCHAIN_GROUP = <TEAMID>.dev.unnamed.shared
//   PUSH_APP_GROUP = group.dev.unnamed.app
PUSH_ENTITLEMENT = NO
PUSH_ENTITLEMENTS_FILE =
PUSH_KEYCHAIN_GROUP =
PUSH_APP_GROUP =
