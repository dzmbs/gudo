<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used only when Brand.xcconfig sets FILES_PROVIDER = YES and FILES_PROVIDER_ENTITLEMENTS_FILE
     to this file (needs a paid team). The app holds the same groups. -->
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(FILES_KEYCHAIN_GROUP)</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(FILES_APP_GROUP)</string>
	</array>
</dict>
</plist>
