<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used only when Brand.xcconfig sets PUSH_ENTITLEMENT = YES and PUSH_ENTITLEMENTS_FILE to this
     file (needs a paid team). The Notification Service Extension uses the same groups. -->
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(PUSH_KEYCHAIN_GROUP)</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(PUSH_APP_GROUP)</string>
	</array>
</dict>
</plist>
